<Window x:Class="MonitorInputSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MonitorInputSwitcher"
        Language="{x:Static local:UiText.Language}"
        Title="Monitor Input Switcher" Icon="Assets/app.ico" Width="492" Height="630" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#182338" />
        <SolidColorBrush x:Key="Field" Color="#222F46" />
        <SolidColorBrush x:Key="Edge" Color="#62728E" />
        <SolidColorBrush x:Key="Ink" Color="#F8FAFC" />
        <SolidColorBrush x:Key="Muted" Color="#B3C0D3" />
        <SolidColorBrush x:Key="Accent" Color="#82E6B1" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#222F46" />
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F8FAFC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#222F46" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F8FAFC" />
        <Style x:Key="KeyboardFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource Accent}" BorderThickness="2"
                                CornerRadius="6" Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Face" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#0F251D" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Margin="0,0,12,0" Padding="10,8">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="0,0,0,5" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}"
                                                BorderThickness="1" CornerRadius="5" Padding="9,5">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Fill="{StaticResource Ink}" Data="M 0 0 L 8 0 L 4 5 Z"
                                          Margin="10,0,1,0" VerticalAlignment="Center" />
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Edge}"
                                        BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="260"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Padding" Value="8,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#37506E" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource Surface}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource Edge}" CornerRadius="3" Margin="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="{StaticResource Surface}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Monitor Input Switcher" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
            <TabItem Header="{x:Static local:UiText.Controls}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,3,4">
                        <Border Background="{StaticResource Surface}" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{x:Static local:UiText.Monitor}" Foreground="{StaticResource Muted}" Margin="0,0,0,9" />
                                <TextBlock x:Name="MonitorText" Grid.Column="1" Text="{x:Static local:UiText.Detecting}" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="1" Text="DDC/CI" Foreground="{StaticResource Muted}" Margin="0,0,0,9" />
                                <TextBlock x:Name="DdcText" Grid.Row="1" Grid.Column="1" Text="{x:Static local:UiText.Unchecked}" Margin="0,0,0,9" />
                                <TextBlock Grid.Row="2" Text="{x:Static local:UiText.CurrentInput}" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="SourceText" Grid.Row="2" Grid.Column="1" Text="{x:Static local:UiText.Unknown}" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="PcButton" Content="PC · DisplayPort" Height="64" Click="PcClick" />
                            <Button x:Name="LaptopButton" Grid.Column="2" Content="Laptop · HDMI" Height="64" Click="LaptopClick" />
                        </Grid>
                        <Button x:Name="ToggleButton" Style="{StaticResource Primary}" Content="Switch Input"
                                Click="ToggleClick" Margin="0,0,0,9" />
                        <Button x:Name="ProbeButton" Content="{x:Static local:UiText.CheckConnection}" Click="ProbeClick" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static local:UiText.Settings}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,8,8">
                        <Label Content="{x:Static local:UiText.TargetMonitor}" Target="{Binding ElementName=MonitorBox}" />
                        <ComboBox x:Name="MonitorBox" DisplayMemberPath="Label" Margin="0,0,0,10" />
                        <Label Content="{x:Static local:UiText.LaptopPort}" Target="{Binding ElementName=HdmiBox}" />
                        <ComboBox x:Name="HdmiBox" Margin="0,0,0,10">
                            <ComboBoxItem Content="{x:Static local:UiText.SelectPort}" />
                            <ComboBoxItem Content="HDMI 1 · 0x11" />
                            <ComboBoxItem Content="HDMI 2 · 0x12" />
                        </ComboBox>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="{x:Static local:UiText.DisplayPortCode}" Target="{Binding ElementName=PcCodeBox}" />
                                <TextBox x:Name="PcCodeBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{x:Static local:UiText.CustomHdmiCode}" Target="{Binding ElementName=HdmiCodeBox}" />
                                <TextBox x:Name="HdmiCodeBox" ToolTip="{x:Static local:UiText.CustomHdmiHint}" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="OverrideBox" Content="{x:Static local:UiText.AllowUnverified}" />
                        <CheckBox x:Name="StartupBox" Content="{x:Static local:UiText.StartWithWindows}" Margin="0,0,0,8" />
                        <TextBlock Text="{x:Static local:UiText.Hotkeys}" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Static local:UiText.HotkeyExample}" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="PC" Target="{Binding ElementName=PcKeyBox}" /><TextBox x:Name="PcKeyBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Laptop" Target="{Binding ElementName=LaptopKeyBox}" /><TextBox x:Name="LaptopKeyBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Label Content="Toggle" Target="{Binding ElementName=ToggleKeyBox}" /><TextBox x:Name="ToggleKeyBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,5,3,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="{x:Static local:UiText.SaveSettings}" Click="SaveClick" />
                        <Button Grid.Column="2" Content="{x:Static local:UiText.DesktopShortcuts}" Click="ShortcutsClick" />
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem x:Name="SharingTab" Header="{x:Static local:UiText.Sharing}">
                <local:LanSharingPanel x:Name="SharingPanel" />
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
            <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Text="{x:Static local:UiText.Ready}"
                           AutomationProperties.LiveSetting="Polite" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
